<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- sc360.budget.line list (standalone, editable)                 -->
    <!-- ============================================================ -->

    <record id="view_budget_line_list" model="ir.ui.view">
        <field name="name">sc360.budget.line.list</field>
        <field name="model">sc360.budget.line</field>
        <field name="arch" type="xml">
            <list editable="bottom"
                  decoration-danger="variance &lt; 0"
                  decoration-success="variance &gt; 0">
                <field name="project_partition_id" column_invisible="1"/>
                <field name="project_id" optional="show"/>
                <field name="concept_id"/>
                <field name="uom_id"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="amount_budget" sum="Total presupuesto"/>
                <field name="amount_purchased" sum="Total comprado" optional="show"/>
                <field name="amount_estimated" sum="Total estimado" optional="show"/>
                <field name="variance" sum="Variacion" optional="show"/>
                <field name="progress_pct" widget="progressbar" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_budget_line_form" model="ir.ui.view">
        <field name="name">sc360.budget.line.form</field>
        <field name="model">sc360.budget.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Informacion">
                            <field name="project_partition_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="concept_id"/>
                            <field name="uom_id"/>
                        </group>
                        <group string="Presupuesto">
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount_budget"/>
                        </group>
                    </group>
                    <group string="Ejecucion">
                        <group>
                            <field name="amount_purchased"/>
                            <field name="amount_estimated"/>
                        </group>
                        <group>
                            <field name="variance"/>
                            <field name="progress_pct" widget="progressbar"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_line_search" model="ir.ui.view">
        <field name="name">sc360.budget.line.search</field>
        <field name="model">sc360.budget.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="concept_id"/>
                <field name="project_id"/>
                <field name="project_partition_id"/>
                <group string="Agrupar por">
                    <filter string="Proyecto" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Partida" name="group_partition"
                            context="{'group_by': 'project_partition_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- sc360.project.partition form (inline in project via o2m)      -->
    <!-- ============================================================ -->

    <record id="view_project_partition_form" model="ir.ui.view">
        <field name="name">sc360.project.partition.form</field>
        <field name="model">sc360.project.partition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="total_budget"/>
                        </group>
                    </group>
                    <div>
                        <button name="action_load_concepts" type="object"
                                string="Cargar conceptos del catalogo"
                                class="oe_highlight" icon="fa-download"/>
                    </div>
                    <field name="budget_line_ids">
                        <list editable="bottom"
                              decoration-danger="variance &lt; 0"
                              decoration-success="variance &gt; 0">
                            <field name="concept_id"/>
                            <field name="uom_id"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount_budget" sum="Total presupuesto"/>
                            <field name="amount_purchased" sum="Total comprado"/>
                            <field name="amount_estimated" sum="Total estimado"/>
                            <field name="variance" sum="Variacion"/>
                            <field name="progress_pct" widget="progressbar"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action (for standalone budget line view)                     -->
    <!-- ============================================================ -->

    <record id="action_budget_line" model="ir.actions.act_window">
        <field name="name">Presupuestos</field>
        <field name="res_model">sc360.budget.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay lineas de presupuesto</p>
        </field>
    </record>

</odoo>
