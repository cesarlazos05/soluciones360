<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Actions                                                      -->
    <!-- ============================================================ -->

    <record id="action_concept_category" model="ir.actions.act_window">
        <field name="name">Partidas</field>
        <field name="res_model">sc360.concept.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crear la primera partida del catalogo</p>
        </field>
    </record>

    <record id="action_concept_template" model="ir.actions.act_window">
        <field name="name">Conceptos de obra</field>
        <field name="res_model">sc360.concept.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crear el primer concepto de obra</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Concept Category Views                                       -->
    <!-- ============================================================ -->

    <record id="view_concept_category_list" model="ir.ui.view">
        <field name="name">sc360.concept.category.list</field>
        <field name="model">sc360.concept.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_concept_category_form" model="ir.ui.view">
        <field name="name">sc360.concept.category.form</field>
        <field name="model">sc360.concept.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Descripcion de la partida..."/>
                    <notebook>
                        <page string="Conceptos" name="concepts">
                            <field name="concept_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="uom_id"/>
                                    <field name="default_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_concept_category_search" model="ir.ui.view">
        <field name="name">sc360.concept.category.search</field>
        <field name="model">sc360.concept.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter string="Archivados" name="inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Concept Template Views                                       -->
    <!-- ============================================================ -->

    <record id="view_concept_template_list" model="ir.ui.view">
        <field name="name">sc360.concept.template.list</field>
        <field name="model">sc360.concept.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="uom_id"/>
                <field name="default_price"/>
            </list>
        </field>
    </record>

    <record id="view_concept_template_form" model="ir.ui.view">
        <field name="name">sc360.concept.template.form</field>
        <field name="model">sc360.concept.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group string="Informacion general">
                            <field name="category_id"/>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group string="Precio de referencia">
                            <field name="uom_id"/>
                            <field name="default_price"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materiales tipicos" name="materials">
                            <field name="material_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_concept_template_search" model="ir.ui.view">
        <field name="name">sc360.concept.template.search</field>
        <field name="model">sc360.concept.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <separator/>
                <filter string="Archivados" name="inactive"
                        domain="[('active', '=', False)]"/>
                <group string="Agrupar por">
                    <filter string="Partida" name="group_category"
                            context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
