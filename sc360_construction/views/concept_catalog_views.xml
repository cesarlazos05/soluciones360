<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Actions primero (deben existir antes de ser referenciadas) -->

    <record id="action_concept_category" model="ir.actions.act_window">
        <field name="name">Partidas</field>
        <field name="res_model">sc360.concept.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crear la primera partida del catálogo</p>
        </field>
    </record>

    <record id="action_concept_template" model="ir.actions.act_window">
        <field name="name">Conceptos de obra</field>
        <field name="res_model">sc360.concept.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crear el primer concepto de obra</p>
        </field>
    </record>

    <!-- PARTIDAS (CATEGORÍAS) -->

    <record id="view_concept_category_list" model="ir.ui.view">
        <field name="name">sc360.concept.category.list</field>
        <field name="model">sc360.concept.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="concept_count"/>
            </list>
        </field>
    </record>

    <record id="view_concept_category_form" model="ir.ui.view">
        <field name="name">sc360.concept.category.form</field>
        <field name="model">sc360.concept.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_concepts" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="concept_count" string="Conceptos" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Notas internas sobre esta partida..."/>
                        </page>
                        <page string="Sub-partidas" name="children" invisible="not child_ids">
                            <field name="child_ids" mode="list">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="concept_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_concept_category_search" model="ir.ui.view">
        <field name="name">sc360.concept.category.search</field>
        <field name="model">sc360.concept.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name"/>
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- CONCEPTOS -->

    <record id="view_concept_template_list" model="ir.ui.view">
        <field name="name">sc360.concept.template.list</field>
        <field name="model">sc360.concept.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="name"/>
                <field name="uom_id"/>
                <field name="base_unit_price" widget="monetary"/>
                <field name="includes_labor"/>
                <field name="material_count"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_concept_template_form" model="ir.ui.view">
        <field name="name">sc360.concept.template.form</field>
        <field name="model">sc360.concept.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_materials" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="material_count" string="Materiales" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group string="Información general">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="uom_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Precio de referencia">
                            <field name="currency_id" invisible="1"/>
                            <field name="base_unit_price"/>
                            <field name="includes_labor"/>
                            <field name="includes_materials"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción" name="description">
                            <field name="description" placeholder="Descripción detallada del concepto de obra..."/>
                        </page>
                        <page string="Materiales típicos" name="materials">
                            <field name="material_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="qty_per_unit"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="is_optional"/>
                                    <field name="notes"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Notas internas..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_concept_template_search" model="ir.ui.view">
        <field name="name">sc360.concept.template.search</field>
        <field name="model">sc360.concept.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

</odoo>
