<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Contract Form                                                -->
    <!-- ============================================================ -->

    <record id="view_contract_form" model="ir.ui.view">
        <field name="name">sc360.contract.form</field>
        <field name="model">sc360.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object"
                            string="Activar" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_done" type="object"
                            string="Finalizar" class="oe_highlight"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object"
                            string="Cancelar"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" type="object"
                            string="Regresar a borrador"
                            invisible="state not in ('cancel',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_estimations" type="object"
                                class="oe_stat_button" icon="fa-bar-chart">
                            <div class="o_stat_info">
                                <field name="estimation_count" class="o_stat_value"/>
                                <span class="o_stat_text">Estimaciones</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informacion general">
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state != 'draft'"/>
                            <field name="contractor_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Fechas y montos">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="amount_total"/>
                            <field name="amount_estimated"/>
                            <field name="amount_remaining"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conceptos del contrato" name="lines">
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="concept_id"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount" sum="Total contrato"/>
                                    <field name="qty_estimated"/>
                                    <field name="qty_remaining"/>
                                </list>
                            </field>
                        </page>
                        <page string="Estimaciones" name="estimations">
                            <field name="estimation_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="number"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="total" sum="Total"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'approved'"
                                           decoration-warning="state == 'paid'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Contract List                                                -->
    <!-- ============================================================ -->

    <record id="view_contract_list" model="ir.ui.view">
        <field name="name">sc360.contract.list</field>
        <field name="model">sc360.contract</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-success="state == 'active'"
                  decoration-muted="state in ('done', 'cancel')">
                <field name="name"/>
                <field name="project_id"/>
                <field name="category_id"/>
                <field name="contractor_id"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="amount_total" sum="Total contratos"/>
                <field name="amount_estimated" sum="Total estimado" optional="show"/>
                <field name="amount_remaining" sum="Restante" optional="show"/>
                <field name="estimation_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state in ('done', 'cancel')"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Contract Search                                              -->
    <!-- ============================================================ -->

    <record id="view_contract_search" model="ir.ui.view">
        <field name="name">sc360.contract.search</field>
        <field name="model">sc360.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="category_id"/>
                <separator/>
                <filter string="Borrador" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Activos" name="active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Finalizados" name="done"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Cancelados" name="cancel"
                        domain="[('state', '=', 'cancel')]"/>
                <group string="Agrupar por">
                    <filter string="Proyecto" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Contratista" name="group_contractor"
                            context="{'group_by': 'contractor_id'}"/>
                    <filter string="Estado" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Contract Action                                              -->
    <!-- ============================================================ -->

    <record id="action_contract" model="ir.actions.act_window">
        <field name="name">Contratos</field>
        <field name="res_model">sc360.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crear el primer contrato de subcontratista</p>
        </field>
    </record>

</odoo>
