<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_budget_line_list" model="ir.ui.view">
        <field name="name">sc360.budget.line.list</field>
        <field name="model">sc360.budget.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active"
                  decoration-danger="variance &lt; 0" decoration-success="variance > 0">
                <field name="sequence" widget="handle"/>
                <field name="category_id"/>
                <field name="name"/>
                <field name="description" optional="hide"/>
                <field name="uom_id"/>
                <field name="qty_budget"/>
                <field name="unit_price" widget="monetary"/>
                <field name="amount_budget" widget="monetary" sum="Total presupuesto"/>
                <field name="amount_purchased" widget="monetary" sum="Total comprado" optional="show"/>
                <field name="variance" widget="monetary" sum="Variación" optional="show"/>
                <field name="execution_pct" widget="progressbar" optional="show"/>
                <field name="project_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_budget_line_form" model="ir.ui.view">
        <field name="name">sc360.budget.line.form</field>
        <field name="model">sc360.budget.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_requisition" type="object"
                            string="Crear requisición" class="oe_highlight"
                            icon="fa-clipboard"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requisitions" type="object"
                                class="oe_stat_button" icon="fa-clipboard">
                            <field name="requisition_count" string="Requisiciones" widget="statinfo"/>
                        </button>
                        <button name="action_view_purchases" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="purchase_count" string="Compras" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group string="Información">
                            <field name="project_id"/>
                            <field name="category_id"/>
                            <field name="concept_template_id"
                                   placeholder="Seleccionar del catálogo..."
                                   context="{'search_default_group_category': 1}"/>
                            <field name="name"/>
                            <field name="uom_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Presupuesto">
                            <field name="currency_id" invisible="1"/>
                            <field name="qty_budget"/>
                            <field name="unit_price"/>
                            <field name="amount_budget"/>
                        </group>
                    </group>
                    <group string="T.P.U. (opcional)">
                        <group>
                            <field name="tpu_number"/>
                            <field name="tpu_price"/>
                        </group>
                        <group>
                            <field name="tpu_percentage"/>
                        </group>
                    </group>
                    <group string="Ejecución">
                        <group>
                            <field name="amount_purchased"/>
                            <field name="amount_received"/>
                        </group>
                        <group>
                            <field name="variance"/>
                            <field name="variance_pct" widget="percentage"/>
                            <field name="execution_pct" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción" name="description">
                            <field name="description" placeholder="Descripción detallada del concepto..."/>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Notas internas..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_line_search" model="ir.ui.view">
        <field name="name">sc360.budget.line.search</field>
        <field name="model">sc360.budget.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="category_id"/>
                <field name="concept_template_id"/>
                <separator/>
                <filter string="Sobre presupuesto" name="over_budget" domain="[('variance', '&lt;', 0)]"/>
                <filter string="Bajo presupuesto" name="under_budget" domain="[('variance', '>=', 0)]"/>
                <filter string="Sin compras" name="no_purchases" domain="[('amount_purchased', '=', 0)]"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="1" string="Agrupar por">
                    <filter string="Proyecto" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Partida" name="group_by_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_budget_line_pivot" model="ir.ui.view">
        <field name="name">sc360.budget.line.pivot</field>
        <field name="model">sc360.budget.line</field>
        <field name="arch" type="xml">
            <pivot string="Presupuesto">
                <field name="project_id" type="row"/>
                <field name="category_id" type="row"/>
                <field name="amount_budget" type="measure"/>
                <field name="amount_purchased" type="measure"/>
                <field name="variance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_budget_line_graph" model="ir.ui.view">
        <field name="name">sc360.budget.line.graph</field>
        <field name="model">sc360.budget.line</field>
        <field name="arch" type="xml">
            <graph string="Presupuesto vs Ejecutado" type="bar">
                <field name="category_id"/>
                <field name="amount_budget" type="measure"/>
                <field name="amount_purchased" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_budget_line" model="ir.actions.act_window">
        <field name="name">Presupuestos</field>
        <field name="res_model">sc360.budget.line</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay líneas de presupuesto</p>
        </field>
    </record>

    <menuitem id="menu_budget_line"
              name="Presupuestos"
              parent="menu_sc360_operation"
              action="action_budget_line"
              sequence="20"/>

    <menuitem id="menu_budget_report"
              name="Análisis de presupuesto"
              parent="menu_sc360_reports"
              action="action_budget_line"
              sequence="10"/>

</odoo>
