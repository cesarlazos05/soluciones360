<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Dashboard Kanban: Construction Projects KPIs                 -->
    <!-- ============================================================ -->

    <record id="view_dashboard_kanban" model="ir.ui.view">
        <field name="name">project.project.dashboard.kanban</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="supervisor_id"/>
                <field name="total_budget"/>
                <field name="total_purchased"/>
                <field name="budget_variance"/>
                <field name="overall_progress"/>
                <field name="requisition_count"/>
                <field name="contract_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-0">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><span class="text-muted">Cliente: </span><field name="client_id"/></div>
                            <div><span class="text-muted">Supervisor: </span><field name="supervisor_id"/></div>
                            <div class="mt-2">
                                <span class="text-muted">Presupuesto: </span>
                                <strong><field name="total_budget" widget="float"/></strong>
                            </div>
                            <div>
                                <span class="text-muted">Comprado: </span>
                                <field name="total_purchased" widget="float"/>
                            </div>
                            <div>
                                <span class="text-muted">Variacion: </span>
                                <field name="budget_variance" widget="float"/>
                            </div>
                            <div class="mt-2">
                                <span class="text-muted">Avance global: </span>
                                <field name="overall_progress" widget="progressbar"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <span><field name="requisition_count"/> Req</span>
                                <span class="ms-2"><field name="contract_count"/> Contratos</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Dashboard Action                                             -->
    <!-- ============================================================ -->

    <record id="action_dashboard" model="ir.actions.act_window">
        <field name="name">Control Presupuestal</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_dashboard_kanban"/>
        <field name="domain">[('is_construction', '=', True)]</field>
        <field name="context">{'default_is_construction': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay proyectos de construccion para mostrar
            </p>
        </field>
    </record>

</odoo>
