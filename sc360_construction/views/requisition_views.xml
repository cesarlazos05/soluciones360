<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Requisition Form                                             -->
    <!-- ============================================================ -->

    <record id="view_requisition_form" model="ir.ui.view">
        <field name="name">sc360.requisition.form</field>
        <field name="model">sc360.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object"
                            string="Enviar" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Aprobar" class="oe_highlight"
                            invisible="state != 'sent'"
                            groups="sc360_construction.group_sc360_manager"/>
                    <button name="action_reject" type="object"
                            string="Rechazar"
                            invisible="state != 'sent'"
                            groups="sc360_construction.group_sc360_manager"/>
                    <button name="action_create_purchase_orders" type="object"
                            string="Generar ODC" class="oe_highlight"
                            invisible="state != 'approved'"
                            groups="sc360_construction.group_sc360_purchase"/>
                    <button name="action_done" type="object"
                            string="Completar"
                            invisible="state != 'in_purchase'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,approved,in_purchase,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchases" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="purchase_count == 0">
                            <field name="purchase_count" string="ODCs" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informacion general">
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state != 'draft'"/>
                            <field name="concept_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Responsables y fechas">
                            <field name="requester_id"/>
                            <field name="approver_id"/>
                            <field name="date_required"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materiales" name="lines">
                            <field name="line_ids"
                                   readonly="state not in ('draft', 'sent')">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="qty_purchased"
                                           decoration-success="qty_purchased >= quantity"/>
                                    <field name="qty_remaining"/>
                                </list>
                            </field>
                        </page>
                        <page string="Evidencias" name="photos">
                            <field name="photo_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Notas adicionales..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Requisition List                                             -->
    <!-- ============================================================ -->

    <record id="view_requisition_list" model="ir.ui.view">
        <field name="name">sc360.requisition.list</field>
        <field name="model">sc360.requisition</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'sent'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="category_id" optional="show"/>
                <field name="requester_id"/>
                <field name="date_required" optional="show"/>
                <field name="purchase_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'sent'"
                       decoration-success="state in ('approved', 'done')"
                       decoration-danger="state == 'in_purchase'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Requisition Kanban                                           -->
    <!-- ============================================================ -->

    <record id="view_requisition_kanban" model="ir.ui.view">
        <field name="name">sc360.requisition.kanban</field>
        <field name="model">sc360.requisition</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="project_id"/>
                <field name="requester_id"/>
                <field name="state"/>
                <field name="purchase_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-0">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <field name="state" widget="badge"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="project_id"/>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <span><field name="purchase_count"/> ODCs</span>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="requester_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Requisition Search                                           -->
    <!-- ============================================================ -->

    <record id="view_requisition_search" model="ir.ui.view">
        <field name="name">sc360.requisition.search</field>
        <field name="model">sc360.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="requester_id"/>
                <field name="category_id"/>
                <separator/>
                <filter string="Mis requisiciones" name="my_requisitions"
                        domain="[('requester_id', '=', uid)]"/>
                <separator/>
                <filter string="Borrador" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Enviadas" name="sent"
                        domain="[('state', '=', 'sent')]"/>
                <filter string="Aprobadas" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="En compra" name="in_purchase"
                        domain="[('state', '=', 'in_purchase')]"/>
                <filter string="Completadas" name="done"
                        domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Proyecto" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Estado" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Solicitante" name="group_requester"
                            context="{'group_by': 'requester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Requisition Actions                                          -->
    <!-- ============================================================ -->

    <record id="action_requisition" model="ir.actions.act_window">
        <field name="name">Requisiciones</field>
        <field name="res_model">sc360.requisition</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crear la primera requisicion de materiales</p>
        </field>
    </record>

</odoo>
