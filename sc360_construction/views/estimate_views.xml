<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Período de Estimación - Formulario -->
    <record id="estimate_period_view_form" model="ir.ui.view">
        <field name="name">sc360.estimate.period.form</field>
        <field name="model">sc360.estimate.period</field>
        <field name="arch" type="xml">
            <form string="Período de Estimación">
                <header>
                    <button name="action_open" string="Abrir" type="object" 
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_close" string="Cerrar" type="object" 
                            invisible="state != 'open'" class="oe_highlight"/>
                    <button name="action_draft" string="Reabrir" type="object" 
                            invisible="state != 'closed'" groups="sc360_construction.group_sc360_manager"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Ej: Semana 12"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="amount_approved"/>
                            <field name="estimate_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Estimaciones" name="estimates">
                            <field name="estimate_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Período de Estimación - Lista -->
    <record id="estimate_period_view_tree" model="ir.ui.view">
        <field name="name">sc360.estimate.period.tree</field>
        <field name="model">sc360.estimate.period</field>
        <field name="arch" type="xml">
            <tree string="Períodos de Estimación" 
                  decoration-info="state=='draft'"
                  decoration-success="state=='open'"
                  decoration-muted="state=='closed'">
                <field name="name"/>
                <field name="code"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="estimate_count"/>
                <field name="amount_approved" sum="Total"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Estimación - Formulario -->
    <record id="estimate_view_form" model="ir.ui.view">
        <field name="name">sc360.estimate.form</field>
        <field name="model">sc360.estimate</field>
        <field name="arch" type="xml">
            <form string="Estimación de Avance">
                <header>
                    <button name="action_submit" string="Enviar" type="object" 
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve" string="Aprobar" type="object" 
                            invisible="state != 'submitted'" class="oe_highlight"
                            groups="sc360_construction.group_sc360_supervisor"/>
                    <button name="action_reject" string="Rechazar" type="object" 
                            invisible="state != 'submitted'"
                            groups="sc360_construction.group_sc360_supervisor"/>
                    <button name="action_pay" string="Marcar Pagada" type="object" 
                            invisible="state != 'approved'" class="oe_highlight"
                            groups="sc360_construction.group_sc360_manager"/>
                    <button name="action_draft" string="Volver a Borrador" type="object" 
                            invisible="state not in ('submitted', 'approved')"/>
                    <button name="action_cancel" string="Cancelar" type="object" 
                            invisible="state not in ('draft', 'submitted')"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_lines" 
                                type="object" icon="fa-list">
                            <field string="Conceptos" name="line_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" 
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="period_id" 
                                   domain="[('state', '=', 'open')]"
                                   options="{'no_create': True}"/>
                            <field name="contractor_id"/>
                            <field name="supervisor_id"/>
                        </group>
                        <group>
                            <field name="contract_amount"/>
                            <field name="previous_amount"/>
                            <field name="amount_total"/>
                            <field name="accumulated_amount"/>
                            <field name="progress_pct" widget="progressbar"/>
                        </group>
                    </group>
                    <group groups="sc360_construction.group_sc360_supervisor">
                        <group string="Fechas">
                            <field name="date_submit" readonly="1"/>
                            <field name="date_approve" readonly="1"/>
                            <field name="date_pay" readonly="1"/>
                        </group>
                        <group string="Retención">
                            <field name="retention_pct"/>
                            <field name="amount_retention"/>
                            <field name="amount_approved"/>
                            <field name="amount_to_pay"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conceptos" name="lines">
                            <button name="action_add_all_concepts" string="Añadir todos los conceptos" 
                                    type="object" class="oe_highlight"
                                    invisible="state != 'draft'"/>
                            <field name="line_ids" 
                                   context="{'default_estimate_id': id}"
                                   readonly="state not in ('draft', 'submitted')"/>
                        </page>
                        <page string="Evidencias" name="evidence">
                            <field name="evidence_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notas" name="notes" groups="sc360_construction.group_sc360_user">
                            <field name="notes" placeholder="Observaciones..."/>
                            <field name="rejection_reason" 
                                   invisible="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Estimación - Lista (para vista One2many) -->
    <record id="estimate_view_tree_embedded" model="ir.ui.view">
        <field name="name">sc360.estimate.tree.embedded</field>
        <field name="model">sc360.estimate</field>
        <field name="arch" type="xml">
            <tree string="Estimaciones" 
                  decoration-info="state=='submitted'"
                  decoration-success="state=='paid'"
                  decoration-warning="state=='approved'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_approved" sum="Aprobado"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Estimación - Lista (principal) -->
    <record id="estimate_view_tree" model="ir.ui.view">
        <field name="name">sc360.estimate.tree</field>
        <field name="model">sc360.estimate</field>
        <field name="arch" type="xml">
            <tree string="Estimaciones" 
                  decoration-info="state=='submitted'"
                  decoration-success="state=='paid'"
                  decoration-warning="state=='approved'">
                <field name="name"/>
                <field name="period_id"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_approved" sum="Aprobado"/>
                <field name="progress_pct" widget="progressbar"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Estimación - Búsqueda -->
    <record id="estimate_view_search" model="ir.ui.view">
        <field name="name">sc360.estimate.search</field>
        <field name="model">sc360.estimate</field>
        <field name="arch" type="xml">
            <search string="Buscar Estimaciones">
                <field name="name"/>
                <field name="project_id"/>
                <field name="period_id"/>
                <field name="contractor_id"/>
                <filter string="Borradores" name="draft" 
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Enviadas" name="submitted" 
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Aprobadas" name="approved" 
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Pagadas" name="paid" 
                        domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Obra" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Período" name="group_period" context="{'group_by': 'period_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Estimación - Kanban -->
    <record id="estimate_view_kanban" model="ir.ui.view">
        <field name="name">sc360.estimate.kanban</field>
        <field name="model">sc360.estimate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="id"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="period_id"/>
                <field name="amount_total"/>
                <field name="amount_approved"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div><field name="project_id"/></div>
                                <div><field name="period_id"/></div>
                                <div class="o_kanban_record_bottom">
                                    <span class="oe_kanban_bottom_left">
                                        <field name="amount_total" widget="monetary"/>
                                    </span>
                                    <span class="oe_kanban_bottom_right">
                                        <span t-attf-class="label label-#{state=='paid'?'success':state=='approved'?'warning':state=='submitted'?'info':'default'}">
                                            <field name="state"/>
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acciones -->
    <record id="estimate_period_action" model="ir.actions.act_window">
        <field name="name">Períodos de Estimación</field>
        <field name="res_model">sc360.estimate.period</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Defina períodos de estimación (semanas, quincenas, meses)
            </p>
        </field>
    </record>

    <record id="estimate_action" model="ir.actions.act_window">
        <field name="name">Estimaciones de Avance</field>
        <field name="res_model">sc360.estimate</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="search_view_id" ref="estimate_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree estimaciones de avance para registrar el progreso de obra
            </p>
        </field>
    </record>

    <!-- Acción desde Obra -->
    <record id="project_estimate_action" model="ir.actions.act_window">
        <field name="name">Estimaciones</field>
        <field name="res_model">sc360.estimate</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('project_id', '=', active_id)]</field>
        <field name="context">{'default_project_id': active_id}</field>
    </record>

</odoo>