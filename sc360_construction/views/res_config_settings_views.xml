<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Inherit res.config.settings form                             -->
    <!-- ============================================================ -->

    <record id="view_res_config_settings_form_sc360" model="ir.ui.view">
        <field name="name">res.config.settings.form.sc360</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="SC360 Construccion"
                     string="SC360 Construccion"
                     groups="sc360_construction.group_sc360_manager">
                    <block title="Requisiciones">
                        <setting string="Aprobador por defecto"
                                 help="Usuario que se asignara automaticamente como aprobador en nuevas requisiciones.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="sc360_default_approver_id" class="col-lg-3"/>
                                    <field name="sc360_default_approver_id"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action to open SC360 settings                                -->
    <!-- ============================================================ -->

    <record id="action_sc360_config_settings" model="ir.actions.act_window">
        <field name="name">Ajustes SC360</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'sc360_construction'}</field>
    </record>

</odoo>
