<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view del wizard de importación -->
    <record id="view_import_catalog_wizard_form" model="ir.ui.view">
        <field name="name">sc360.import.catalog.wizard.form</field>
        <field name="model">sc360.import.catalog.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar catálogo">
                <group invisible="result_message">
                    <group string="Archivo">
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group string="Tipo de importación">
                        <field name="import_type" widget="radio"/>
                        <field name="project_id" 
                               invisible="import_type != 'budget'"
                               required="import_type == 'budget'"/>
                    </group>
                </group>
                <group string="Opciones" invisible="result_message">
                    <field name="update_existing"/>
                    <field name="create_categories"/>
                    <field name="create_products" invisible="import_type != 'catalog'"/>
                </group>
                <group invisible="not result_message">
                    <field name="result_message" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" 
                            string="Importar" class="btn-primary"
                            invisible="result_message"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action del wizard -->
    <record id="action_import_catalog_wizard" model="ir.actions.act_window">
        <field name="name">Importar catálogo</field>
        <field name="res_model">sc360.import.catalog.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
