<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Categoría de módulo -->
        <record id="module_category_sc360" model="ir.module.category">
            <field name="name">SC360 Construcción</field>
            <field name="description">Gestión de proyectos de construcción SC360</field>
            <field name="sequence">50</field>
        </record>
        
        <!-- Grupos de usuario -->
        <record id="group_sc360_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="category_id" ref="module_category_sc360"/>
            <field name="comment">Puede ver proyectos, crear requisiciones y consultar información</field>
        </record>
        
        <record id="group_sc360_supervisor" model="res.groups">
            <field name="name">Supervisor de obra</field>
            <field name="category_id" ref="module_category_sc360"/>
            <field name="implied_ids" eval="[(4, ref('group_sc360_user'))]"/>
            <field name="comment">Puede gestionar requisiciones y ver presupuestos de sus proyectos</field>
        </record>
        
        <record id="group_sc360_purchase" model="res.groups">
            <field name="name">Compras</field>
            <field name="category_id" ref="module_category_sc360"/>
            <field name="implied_ids" eval="[(4, ref('group_sc360_user'))]"/>
            <field name="comment">Puede procesar requisiciones y generar órdenes de compra</field>
        </record>
        
        <record id="group_sc360_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="module_category_sc360"/>
            <field name="implied_ids" eval="[(4, ref('group_sc360_supervisor')), (4, ref('group_sc360_purchase'))]"/>
            <field name="comment">Acceso completo a todas las funciones de SC360</field>
        </record>
        
    </data>
</odoo>
