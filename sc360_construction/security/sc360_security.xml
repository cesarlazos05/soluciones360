<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Module category -->
    <record id="module_category_sc360" model="ir.module.category">
        <field name="name">SC360 Construccion</field>
        <field name="sequence">100</field>
    </record>

    <!-- Group: Supervisor de Obra (base) -->
    <record id="group_sc360_user" model="res.groups">
        <field name="name">Supervisor de Obra</field>
        <field name="category_id" ref="module_category_sc360"/>
    </record>

    <!-- Group: Compras (implies user) -->
    <record id="group_sc360_purchase" model="res.groups">
        <field name="name">Compras</field>
        <field name="category_id" ref="module_category_sc360"/>
        <field name="implied_ids" eval="[(4, ref('group_sc360_user'))]"/>
    </record>

    <!-- Group: Arquitectura (implies user) -->
    <record id="group_sc360_architect" model="res.groups">
        <field name="name">Arquitectura</field>
        <field name="category_id" ref="module_category_sc360"/>
        <field name="implied_ids" eval="[(4, ref('group_sc360_user'))]"/>
    </record>

    <!-- Group: Administrador (implies purchase + architect) -->
    <record id="group_sc360_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_sc360"/>
        <field name="implied_ids" eval="[(4, ref('group_sc360_purchase')), (4, ref('group_sc360_architect'))]"/>
    </record>

</odoo>
