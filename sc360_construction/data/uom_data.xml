<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Categoría para unidades de construcción -->
        <record id="uom_categ_construction" model="uom.category">
            <field name="name">Construcción</field>
        </record>

        <!-- Unidades comunes en construcción mexicana -->
        <record id="uom_m2" model="uom.uom">
            <field name="name">m²</field>
            <field name="category_id" ref="uom.product_uom_categ_unit"/>
            <field name="factor">1</field>
            <field name="uom_type">reference</field>
            <field name="rounding">0.01</field>
        </record>

        <record id="uom_m3" model="uom.uom">
