<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Secuencia para requisiciones -->
        <record id="sequence_sc360_requisition" model="ir.sequence">
            <field name="name">Requisicion SC360</field>
            <field name="code">sc360.requisition</field>
            <field name="prefix">REQ-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Secuencia para contratos -->
        <record id="sequence_sc360_contract" model="ir.sequence">
            <field name="name">Contrato SC360</field>
            <field name="code">sc360.contract</field>
            <field name="prefix">CON-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Secuencia para estimaciones -->
        <record id="sequence_sc360_estimate" model="ir.sequence">
            <field name="name">Estimacion SC360</field>
            <field name="code">sc360.estimate</field>
            <field name="prefix">EST-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
