<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Inherit project.project form                                 -->
    <!-- ============================================================ -->

    <record id="view_project_form_sc360" model="ir.ui.view">
        <field name="name">project.project.form.sc360</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <!-- is_construction toggle near project name -->
            <xpath expr="//field[@name='label_tasks']" position="before">
                <field name="is_construction"/>
            </xpath>

            <!-- Smart buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_requisitions" type="object"
                        class="oe_stat_button" icon="fa-clipboard"
                        invisible="not is_construction">
                    <div class="o_stat_info">
                        <field name="requisition_count" class="o_stat_value"/>
                        <span class="o_stat_text">Requisiciones</span>
                    </div>
                </button>
                <button name="action_view_contracts" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not is_construction">
                    <div class="o_stat_info">
                        <field name="contract_count" class="o_stat_value"/>
                        <span class="o_stat_text">Contratos</span>
                    </div>
                </button>
                <button name="action_view_estimations" type="object"
                        class="oe_stat_button" icon="fa-bar-chart"
                        invisible="not is_construction">
                    <div class="o_stat_info">
                        <field name="estimation_count" class="o_stat_value"/>
                        <span class="o_stat_text">Estimaciones</span>
                    </div>
                </button>
                <button name="action_view_logbooks" type="object"
                        class="oe_stat_button" icon="fa-book"
                        invisible="not is_construction">
                    <div class="o_stat_info">
                        <field name="logbook_count" class="o_stat_value"/>
                        <span class="o_stat_text">Bitacora</span>
                    </div>
                </button>
                <button name="action_view_purchases" type="object"
                        class="oe_stat_button" icon="fa-shopping-cart"
                        invisible="not is_construction">
                    <div class="o_stat_info">
                        <field name="purchase_count" class="o_stat_value"/>
                        <span class="o_stat_text">Compras</span>
                    </div>
                </button>
            </xpath>

            <!-- Construccion SC360 tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Construccion SC360" name="sc360_construction"
                      invisible="not is_construction">

                    <!-- KPI section -->
                    <group string="Indicadores">
                        <group>
                            <field name="total_budget"/>
                            <field name="total_purchased"/>
                        </group>
                        <group>
                            <field name="budget_variance"/>
                            <field name="overall_progress" widget="progressbar"/>
                        </group>
                    </group>

                    <!-- Project data -->
                    <group>
                        <group string="Datos del proyecto">
                            <field name="client_id"/>
                            <field name="supervisor_id"/>
                            <field name="architect_id"/>
                            <field name="project_type"/>
                        </group>
                        <group string="Datos de la obra">
                            <field name="surface_area"/>
                            <field name="address"/>
                            <field name="warehouse_id" readonly="1"/>
                        </group>
                    </group>
                </page>

                <page string="Partidas y Presupuesto" name="sc360_partitions"
                      invisible="not is_construction">
                    <field name="partition_ids">
                        <list editable="bottom">
                            <field name="category_id"/>
                            <field name="total_budget" sum="Total presupuesto"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Inherit project.project list                                 -->
    <!-- ============================================================ -->

    <record id="view_project_list_sc360" model="ir.ui.view">
        <field name="name">project.project.list.sc360</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_construction" optional="hide"/>
                <field name="project_type" optional="hide"/>
                <field name="supervisor_id" optional="hide"/>
                <field name="total_budget" optional="hide"/>
                <field name="overall_progress" widget="progressbar" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Inherit project.project search                               -->
    <!-- ============================================================ -->

    <record id="view_project_search_sc360" model="ir.ui.view">
        <field name="name">project.project.search.sc360</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_projects']" position="after">
                <separator/>
                <filter string="Proyectos de construccion" name="construction"
                        domain="[('is_construction', '=', True)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Tipo de proyecto" name="group_project_type"
                        context="{'group_by': 'project_type'}"/>
                <filter string="Supervisor" name="group_supervisor"
                        context="{'group_by': 'supervisor_id'}"/>
                <filter string="Cliente" name="group_client"
                        context="{'group_by': 'client_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action: Construction projects                                -->
    <!-- ============================================================ -->

    <record id="action_sc360_projects" model="ir.actions.act_window">
        <field name="name">Proyectos de obra</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_construction', '=', True)]</field>
        <field name="context">{'default_is_construction': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear el primer proyecto de construccion
            </p>
        </field>
    </record>

</odoo>
