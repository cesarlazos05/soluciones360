<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard - Acción que muestra proyectos con KPIs -->
    <record id="dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboard Ejecutivo</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('is_construction', '=', True)]</field>
        <field name="context">{'default_is_construction': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Vista general del estado de todas las obras
            </p>
        </field>
    </record>

    <!-- Vista Kanban de Proyectos con KPIs -->
    <record id="project_construction_view_kanban" model="ir.ui.view">
        <field name="name">project.project.construction.kanban</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id">
                <field name="id"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="total_budget"/>
                <field name="budget_execution_pct"/>
                <field name="total_purchased"/>
                <field name="budget_variance"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><field name="client_id"/></div>
                                    <div>
                                        <span class="text-muted">Presupuesto:</span>
                                        <field name="total_budget" widget="monetary"/>
                                    </div>
                                    <div>
                                        <span class="text-muted">Ejecutado:</span>
                                        <field name="budget_execution_pct" widget="progressbar"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <span class="oe_kanban_bottom_left">
                                        <span t-esc="record.budget_execution_pct"/>%
                                    </span>
                                    <span class="oe_kanban_bottom_right">
                                        <field name="stage_id"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Tree extendida de Proyecto -->
    <record id="project_construction_view_tree_dashboard" model="ir.ui.view">
        <field name="name">project.project.construction.tree.dashboard</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_tree"/>
        <field name="domain">[('is_construction', '=', True)]</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="client_id"/>
                <field name="total_budget" sum="Presupuesto"/>
                <field name="budget_execution_pct" widget="progressbar"/>
                <field name="budget_variance"/>
            </xpath>
        </field>
    </record>

</odoo>